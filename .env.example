# ==============================================================================
# TourFlow AI - Enterprise Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Intelligence (Google Gemini API - Server-Side Only)
# ------------------------------------------------------------------------------
# Obtain key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Model Designations & Cascading Fallback Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.7-flash,gemini-flash-latest,gemini-3.1-flash-lite

# Generation Controls & Sampling Hyperparameters
GEMINI_TEMPERATURE=1.0
GEMINI_CONVERSATIONAL_TEMPERATURE=1.0
GEMINI_STRUCTURED_TEMPERATURE=1.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# Resilience & Exponential Backoff Settings
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_MS=1000
GEMINI_MAX_BACKOFF_MS=10000
GEMINI_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. Live Hotel Search (SerpApi Google Hotels - Server-Side Only)
# ------------------------------------------------------------------------------
# Obtain a key at https://serpapi.com/users/sign_up and place it in your local
# .env only. Never commit a real key. Leave empty to disable live hotel search.
# Do NOT prefix with VITE_ and do NOT reference it from frontend code.
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Weather / Live Conditions (Server-Side Only)
# ------------------------------------------------------------------------------
# Open-Meteo is free and requires no key. Leave WEATHER_API_KEY empty for default provider.
# Set WEATHER_BASE_URL to empty to disable weather (endpoint will return 503).
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_TIMEOUT_S=8.0

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Local SQLite (Default for instant zero-config setup):
DATABASE_URL=sqlite:///./tourflow.db

# PostgreSQL (Production / Local PostgreSQL instance):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tourflow

# Cloud PostgreSQL (Neon, Supabase, Cloud SQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 5. Application & Server Configuration
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
BACKEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info

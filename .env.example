# ==============================================================================
# TourFlow AI - Enterprise Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Intelligence - Failover Hierarchy (Server-Side Only, never frontend)
#    Order is FIXED and sequential: Provider -> API Key -> Model.
#    Provider priority: Gemini (1) -> OpenRouter (2) -> Grok (3).
#    Stop at the first model that successfully generates a response.
# ------------------------------------------------------------------------------
# --- Gemini (priority 1). Keys from https://aistudio.google.com/app/apikey
# Legacy GEMINI_API_KEY still works as an alias for GEMINI_API_KEY_1.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Ordered CSV: index 0 is the PRIMARY model, rest are fallbacks in order.
# Verified Sep 2026: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OpenRouter (priority 2, OpenAI-compatible). Keys from https://openrouter.ai/keys
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Ordered CSV of currently supported free models (":free" suffix required).
# Verified Sep 2026: https://openrouter.ai/collections/free-models
# Free roster churns: change this list via env, no code change needed.
OPENROUTER_MODELS=openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-30b-a3b:free,cohere/north-mini-code:free
OPENROUTER_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Grok / xAI (priority 3, OpenAI-compatible). Keys from https://console.x.ai
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
# xAI has no $0 tier; defaults are the cheapest documented IDs.
# Verified Sep 2026: https://docs.x.ai/developers/models
GROK_MODELS=grok-4.3,grok-code-fast-1,grok-4-1-fast-reasoning
GROK_ENABLED=true
GROK_BASE_URL=https://api.x.ai/v1

# --- Shared failover resilience (router tuning, no secrets)
AI_MODEL_COOLDOWN_S=300
AI_KEY_COOLDOWN_S=600
AI_PROVIDER_COOLDOWN_S=900
AI_KEY_DISABLE_S=3600
AI_REQUEST_TIMEOUT_S=30
AI_MAX_TRANSIENT_RETRIES=1
AI_INITIAL_BACKOFF_MS=1000
AI_MAX_BACKOFF_MS=10000

# --- Legacy single-provider settings (kept for backward compatibility) ---
# Prefer GEMINI_MODELS above; these are still read by older code paths.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite

# Generation Controls & Sampling Hyperparameters
GEMINI_TEMPERATURE=1.0
GEMINI_CONVERSATIONAL_TEMPERATURE=1.0
GEMINI_STRUCTURED_TEMPERATURE=1.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# Legacy Resilience Settings (superseded by AI_* above for the new router)
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_MS=1000
GEMINI_MAX_BACKOFF_MS=10000
GEMINI_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. Live Hotel Search (SerpApi Google Hotels - Server-Side Only)
# ------------------------------------------------------------------------------
# Obtain a key at https://serpapi.com/users/sign_up and place it in your local
# .env only. Never commit a real key. Leave empty to disable live hotel search.
# Do NOT prefix with VITE_ and do NOT reference it from frontend code.
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Weather / Live Conditions (Server-Side Only)
# ------------------------------------------------------------------------------
# Open-Meteo is free and requires no key. Leave WEATHER_API_KEY empty for default provider.
# Set WEATHER_BASE_URL to empty to disable weather (endpoint will return 503).
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_TIMEOUT_S=8.0

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Local SQLite (Default for instant zero-config setup):
DATABASE_URL=sqlite:///./tourflow.db

# PostgreSQL (Production / Local PostgreSQL instance):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tourflow

# Cloud PostgreSQL (Neon, Supabase, Cloud SQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4b. Operator login (server-side shared password, never frontend).
# ------------------------------------------------------------------------------
# Required for POST /api/auth/operator-login. The endpoint fail-closes with
# 503 when this is empty. Set it in your local .env only — never commit a
# real value. The seeded demo operator is rahul.operator@tourflow.ai.
OPERATOR_LOGIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Application & Server Configuration
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
BACKEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info
